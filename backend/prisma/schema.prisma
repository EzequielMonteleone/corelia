generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum ExpensePeriodStatus {
  OPEN
  CLOSED
}

enum ExpenseStatus {
  UNPAID
  PENDING
  PAID
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REJECTED
  FAILED
}

model Building {
  id        String   @id @default(uuid())
  name      String
  address   String
  city      String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)
  deleted   Boolean  @default(false)
  taxId     String?
  logo      String?
  planType  String?

  units          Unit[]
  buildingAmenities BuildingAmenity[]
  expensePeriods ExpensePeriod[]
  buildingUsers  BuildingUser[]
  expenses       Expense[]
  payments       Payment[]
  documents      BuildingDocument[]
  knowledgeChunks KnowledgeChunk[]
  vehicles       Vehicle[]
}

enum GlobalRole {
  SUPERADMIN
  USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  globalRole   GlobalRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean  @default(true)
  deleted      Boolean  @default(false)

  buildingUsers       BuildingUser[]
  userUnits           UserUnit[]
  amenityReservations AmenityReservation[]
  chatThreads         ChatThread[]
  reservationDrafts   ReservationDraft[]
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  buildingUsers   BuildingUser[]
  rolePermissions RolePermission[]
}

model Unit {
  id          String   @id @default(uuid())
  buildingId  String
  name        String
  floor       String?
  coefficient Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building            Building             @relation(fields: [buildingId], references: [id])
  expenses            Expense[]
  userUnits           UserUnit[]
  amenityReservations AmenityReservation[]
  householdMembers    HouseholdMember[]
  vehicles            Vehicle[]
  pets                Pet[]

  @@unique([buildingId, name])
}

enum HouseholdRelation {
  SPOUSE
  CHILD
  PARENT
  OTHER
}

model HouseholdMember {
  id             String            @id @default(uuid())
  unitId         String
  firstName      String
  lastName       String
  relation       HouseholdRelation
  documentNumber String?
  phone          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
}

model Vehicle {
  id         String   @id @default(uuid())
  unitId     String
  buildingId String
  plate      String
  make       String?
  model      String?
  color      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  building Building @relation(fields: [buildingId], references: [id])

  @@unique([buildingId, plate])
  @@index([unitId])
}

enum PetSpecies {
  DOG
  CAT
  OTHER
}

model Pet {
  id        String     @id @default(uuid())
  unitId    String
  name      String
  species   PetSpecies
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
}

model Amenity {
  id        String   @id @default(uuid())
  key       String?  @unique
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildingAmenities BuildingAmenity[]
}

model BuildingAmenity {
  id            String   @id @default(uuid())
  buildingId    String
  amenityId     String
  isEnabled     Boolean  @default(true)
  slotMinutes   Int      @default(60)
  maxConcurrent Int      @default(1)
  openTime      String   @default("08:00")
  closeTime     String   @default("22:00")
  rules         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  building     Building             @relation(fields: [buildingId], references: [id])
  amenity      Amenity              @relation(fields: [amenityId], references: [id])
  reservations AmenityReservation[]

  @@unique([buildingId, amenityId])
}

enum AmenityReservationStatus {
  CONFIRMED
  CANCELLED
}

model AmenityReservation {
  id                String                   @id @default(uuid())
  buildingAmenityId String
  unitId            String
  userId            String
  startsAt          DateTime
  endsAt            DateTime
  status            AmenityReservationStatus @default(CONFIRMED)
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  buildingAmenity BuildingAmenity @relation(fields: [buildingAmenityId], references: [id], onDelete: Cascade)
  unit            Unit            @relation(fields: [unitId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@index([buildingAmenityId, startsAt])
  @@index([unitId, startsAt])
  @@index([userId])
}

enum UnitRelationType {
  OWNER
  ROOMER
}

model UserUnit {
  id           String           @id @default(uuid())
  userId       String
  unitId       String
  relationType UnitRelationType
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([userId, unitId, relationType])
}

model ExpensePeriod {
  id          String              @id @default(uuid())
  buildingId  String
  period      String
  generatedAt DateTime            @default(now())
  status      ExpensePeriodStatus @default(OPEN)

  building Building  @relation(fields: [buildingId], references: [id])
  expenses Expense[]
}

model BuildingUser {
  id         String   @id @default(uuid())
  buildingId String
  userId     String
  roleId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building Building @relation(fields: [buildingId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  role     Role     @relation(fields: [roleId], references: [id])

  @@unique([buildingId, userId])
}

model Permission {
  id   String @id @default(uuid())
  key  String @unique
  name String

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Expense {
  id         String        @id @default(uuid())
  buildingId String
  unitId     String
  periodId   String
  amount     Decimal       @db.Decimal(12, 2)
  status     ExpenseStatus @default(UNPAID)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  building Building      @relation(fields: [buildingId], references: [id])
  unit     Unit          @relation(fields: [unitId], references: [id])
  period   ExpensePeriod @relation(fields: [periodId], references: [id])
  payments Payment[]
}

model Payment {
  id                String        @id @default(uuid())
  buildingId        String
  expenseId         String
  amount            Decimal       @db.Decimal(12, 2)
  paymentMethod     String?
  externalPaymentId String?
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  building Building @relation(fields: [buildingId], references: [id])
  expense  Expense  @relation(fields: [expenseId], references: [id])
}

enum ChatMessageRole {
  USER
  ASSISTANT
  TOOL
}

model ChatThread {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id])
  messages ChatMessage[]
  drafts   ReservationDraft[]

  @@index([userId])
}

model ChatMessage {
  id        String          @id @default(uuid())
  threadId  String
  role      ChatMessageRole
  content   String
  toolName  String?
  createdAt DateTime        @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

enum ReservationDraftStatus {
  PENDING
  CONFIRMED
  EXPIRED
}

model ReservationDraft {
  id                String                 @id @default(uuid())
  threadId          String
  userId            String
  buildingId        String
  buildingAmenityId String
  unitId            String
  startsAt          DateTime
  notes             String?
  amenityName       String
  unitName          String
  buildingName      String
  status            ReservationDraftStatus @default(PENDING)
  reservationId     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id])

  @@index([threadId, status])
  @@index([userId])
}

enum KnowledgeSourceType {
  AMENITY_RULE
  BYLAW
  NOTICE
}

model BuildingDocument {
  id         String              @id @default(uuid())
  buildingId String
  title      String
  body       String
  kind       KnowledgeSourceType
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
}

model KnowledgeChunk {
  id          String              @id @default(uuid())
  buildingId  String
  sourceType  KnowledgeSourceType
  sourceId    String
  title       String
  heading     String?
  ordinal     Int
  content     String
  contentHash String
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, ordinal])
  @@index([buildingId])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  periodId    String?
  buildingId  String?
  actorUserId String
  metadata    Json?
  createdAt   DateTime @default(now())
}
